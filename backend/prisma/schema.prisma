generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN // manages all hospitals, not tied to any single one
  ADMIN       // manages one hospital: its doctors, staff, and referrals
  RECEPTION   // works the front desk of one hospital
  STAFF       // custom role (e.g. Accountant) — actual capabilities come from CustomRole.permissions
}

enum ReferralStatus {
  PENDING     // patient details submitted via QR, not yet arrived
  ARRIVED     // reserved for future use
  CREDITED    // reception matched & confirmed patient arrival, doctor credited
  REJECTED    // reception determined this wasn't a valid match
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
}

enum VisitType {
  IPD
  OPD
}

model Hospital {
  id         String   @id @default(uuid())
  name       String
  branchName String?
  address    String?
  // Fixed, admin-configurable credit amounts (in INR) paid to the referring doctor
  // when a lead converts, based on whether the patient was admitted (IPD) or seen
  // as an outpatient (OPD). Replaces per-referral manual amount entry at confirm time.
  ipdAmount  Decimal  @default(0) @db.Decimal(10, 2)
  opdAmount  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  staff       StaffUser[]
  doctors     Doctor[]
  customRoles CustomRole[]
  marketingPersons MarketingPerson[]
  importBatches    ImportBatch[]
  activityLogs     ActivityLog[]
}

// One row per meaningful change anywhere in the system for this hospital — referral status
// changes, credit payouts, leaders, marketing team, staff, and settings. Powers the "Activity
// Log" tab so an admin can answer "who did what, and when" without digging through tables.
// Rows are never edited or deleted after being written — it's an append-only audit trail.
model ActivityLog {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])

  // Captured at write time (not a live FK) so the log survives the actor's account being
  // deleted later, and so it still reads correctly if their name/role changes afterward.
  actorUserId String?
  actorName   String
  actorRole   String?

  action      String   // e.g. "referral.credited", "credit.redeemed", "doctor.created" — see ACTIONS in utils/activityLog.js
  entityType  String   // "Referral" | "Doctor" | "CreditTransaction" | "MarketingPerson" | "StaffUser" | "CustomRole" | "Hospital" | "ImportBatch"
  entityId    String?
  entityLabel String?  // human-readable label (patient/doctor/staff name) so the log reads without joins

  // Field-level diff for updates: { fieldName: { from, to }, ... }. Null for pure creates/deletes.
  changes     Json?
  // Anything else worth keeping around for context (amount, file name, reason, etc).
  metadata    Json?

  createdAt   DateTime @default(now())

  @@index([hospitalId, createdAt])
  @@index([hospitalId, entityType, entityId])
}

model MarketingPerson {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  name       String
  phone      String?
  email      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  // Lets this marketing person log into their own read-only portal (via a QR/link + this
  // password) to see their own stats only — no admin/reception capabilities of any kind.
  passwordHash String?

  doctors    Doctor[]
}

// A hospital-defined role (e.g. "Accountant") with a specific, admin-configurable set of
// permissions. Lets admins add new kinds of staff access without any code changes.
model CustomRole {
  id          String   @id @default(uuid())
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  name        String
  // array of permission strings, e.g. ["export_reports", "view_referrals"]
  permissions Json
  createdAt   DateTime @default(now())

  staff StaffUser[]
}

model StaffUser {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role
  // null only for SUPER_ADMIN, who isn't scoped to a single hospital
  hospitalId   String?
  hospital     Hospital?   @relation(fields: [hospitalId], references: [id])
  // set only when role = STAFF; defines this account's actual permissions
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])
  createdAt    DateTime    @default(now())
}

model Doctor {
  id            String   @id @default(uuid())
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id])

  name          String
  specialty     String?
  // The hospital's marketing-team employee this leader is associated with — usually the
  // person who built/maintains the relationship. Left blank for the small share of leaders
  // with no such association. `marketingPersonName` is a deprecated leftover text column
  // (kept only so old data migrates cleanly) — use `marketingPerson` going forward.
  marketingPersonName String?
  marketingPersonId   String?
  marketingPerson     MarketingPerson? @relation(fields: [marketingPersonId], references: [id])
  // Optional: a leader can be quick-added by name only from the "Add patient" flow
  // (reception may not have their phone on hand yet); can be filled in later.
  phone         String?
  email         String?
  clinicName    String?
  city          String?
  uniqueCode    String   @unique @default(uuid())
  // fixed credit amount (in INR) given per successful referral; admin-configurable per doctor
  creditAmount  Decimal  @default(0) @db.Decimal(10, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  referrals     Referral[]
  transactions  CreditTransaction[]
}

model Referral {
  id              String         @id @default(uuid())
  doctor          Doctor         @relation(fields: [doctorId], references: [id])
  doctorId        String

  patientName     String
  patientAge      Int
  patientPhone    String?
  patientGender   PatientGender?

  // location captured at the moment the doctor's QR was scanned
  scanLatitude    Float?
  scanLongitude   Float?
  scanAddress     String?        // reverse-geocoded, human readable
  scanAccuracyM   Float?         // GPS accuracy in meters, if available

  status          ReferralStatus @default(PENDING)
  matchedByUserId String?        // reception/admin staff who marked arrival
  arrivedAt       DateTime?
  rejectedReason  String?

  // Captured by reception at confirmation time (not at submission), once the patient
  // has actually been registered at the hospital. Holds the IPD or OPD file number
  // depending on visitType — not a hospital-wide UHID.
  fileNumber      String?
  visitType       VisitType?     // IPD or OPD — determines which fixed hospital amount is credited
  // Set when an OPD lead is later converted to IPD (e.g. the patient ends up admitted).
  // Non-null convertedAt means this referral was originally confirmed as OPD.
  convertedAt     DateTime?
  // Set by reception when the patient is discharged. Only meaningful once CREDITED;
  // shown to the referring leader so they know the visit is fully wrapped up.
  dischargedAt    DateTime?
  // Insurance company / TPA / government scheme / corporate account this patient's
  // treatment is billed against (e.g. CGHS, ESIC, a named insurer). Set by reception,
  // usually once the file number is known. Free text so new panels don't need a code change.
  panel           String?

  // Card details, usually filled in from an OCR card scan (see CardScanUpload on the
  // frontend) but editable/enterable manually too. idNumber holds whichever number applies
  // to idType — the masked Aadhaar number, the Ayushman/PM-JAY ID, or a CGHS/ECHS/CAPF card
  // number. forceType and wardType only apply to CGHS/ECHS/CAPF cards (e.g. "BSF", "ARMY",
  // "Semi-Private Ward") and are typically blank for Aadhaar/Ayushman.
  idType          String?        // "AADHAAR" | "AYUSHMAN" | "CGHS" | "ECHS" | "CAPF", or null if not set
  idNumber        String?
  forceType       String?
  wardType        String?

  // Set when this referral was created via the "All Referrals" bulk import (Excel upload),
  // so the whole batch can be reviewed and undone together later. Null for referrals created
  // any other way (QR scan, manual add), and for rows imported before this field existed.
  importBatchId   String?
  importBatch     ImportBatch?   @relation(fields: [importBatchId], references: [id])

  // A supporting image uploaded alongside the referral — a photo of an ID/insurance card, a
  // prescription, anything the submitter wants attached as proof of the lead. Currently only
  // settable when a marketing employee submits a lead through their own portal (see
  // POST /referrals/marketing-submit); stores a path served back via the authenticated
  // GET /referrals/:id/attachment route, never a public URL, since these are often photos of
  // ID documents. Null for every other referral-creation path.
  attachmentPath  String?

  createdAt       DateTime       @default(now())

  transaction     CreditTransaction?
}

// One row per "Bulk import" Excel upload on the All Referrals tab. Lets an admin see the
// history of past imports and undo one as a whole (deleting the referrals + any credits
// it created), rather than having to hunt down and delete rows one at a time.
model ImportBatch {
  id               String    @id @default(uuid())
  hospitalId       String
  hospital         Hospital  @relation(fields: [hospitalId], references: [id])

  fileName         String?
  importedByUserId String
  importedByName   String    // captured at import time so the label survives a staff account being deleted later

  createdCount     Int       @default(0)
  skippedCount     Int       @default(0)

  createdAt        DateTime  @default(now())
  // Set once an admin undoes this import. The batch row itself is kept (rather than
  // deleted) as a permanent audit trail of what was imported and when it was reverted.
  revertedAt       DateTime?
  revertedByUserId String?

  referrals        Referral[]
}

model CreditTransaction {
  id               String    @id @default(uuid())
  doctor           Doctor    @relation(fields: [doctorId], references: [id])
  doctorId         String
  referral         Referral  @relation(fields: [referralId], references: [id])
  referralId       String    @unique
  amount           Decimal   @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  note             String?

  // A credit is created the moment reception confirms a patient's arrival, but that
  // only means the doctor is OWED the amount — it isn't paid out yet. An accountant
  // (or admin) later marks it "redeemed" once the actual payout happens, which is
  // what separates "pending credits" from "total earned" on the doctor's dashboard.
  redeemed         Boolean   @default(false)
  redeemedAt       DateTime?
  redeemedByUserId String?
  paymentMethod    String?
  referenceNumber  String?
  remarks          String?
}
